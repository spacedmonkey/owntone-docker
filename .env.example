# Copy this file to .env and adjust the paths for your host.
# Relative paths are resolved from the directory containing docker-compose.yml.

# Music library scanned by OwnTone (mounted at /srv/media)
MUSIC_DIR=./music

# Named pipes shared between OwnTone, librespot and shairport-sync
# (mounted at /srv/pipes, /mnt/pipe and /data respectively)
PIPES_DIR=./pipes

# Config directory; must contain owntone/ and shairport/shairport-sync.conf
CONFIG_DIR=./config

# OwnTone database / cache (owntone/ subfolder is mounted at /var/cache/owntone)
CACHE_DIR=./cache

# Spotify Connect receiver (librespot)
SPOTIFY_DEVICE_NAME=Jukebox
SPOTIFY_DEVICE_TYPE=speaker
SPOTIFY_BITRATE=320
SPOTIFY_INITIAL_VOLUME=100

# libairptp git branch, tag or commit to build airptpd from
LIBAIRPTP_REF=0.7

# owntone/owntone image tag (e.g. latest or staging)
OWNTONE_TAG=latest
